tests/rv64i/**                                      # RV64 用例组：RV32 核不适用（MXLEN=32）
tests/rv64e/**                                      # RV64E 用例组：同上
tests/rv32e/**                                      # RV32E：仅 16 个 GPR，本核为 32 个 GPR 的 RV32I

