#------------------------------------------------------------------------------
# E. Sv39/Sv48/Sv57 明确登记（RV32 只有 Sv32；这些变体在 RV64 才有意义）
#    说明：A 段的 `tests/priv/**` 整体排除已**收窄为逐条排除**，本段承接其中
#    "RV64 专属分页模式"那一类，逐条登记是为了让「RV32 只跑 sv32_* 变体」这条纪律
#    可被单独复核（08 §8.2 的筛选要求原文）。既有 15 条全部保留不删（**只做命名迁移**：
#    `<目录>/sv3x_*` → `<目录>/<目录>_sv3x_*`，命中集合不变）；
#    ExceptionsSv* 三条的 sv39_* 亦被 A 段 `tests/priv/ExceptionsSv*` 覆盖，但保留
#    逐条登记（真实命中仍在，且 sv39_* 的登记不依赖族规则；该三目录未扁平化，规则原样）。
#------------------------------------------------------------------------------
tests/priv/SvPMP/SvPMP_sv39_*                       # Sv39 分页：RV32 无此模式
tests/priv/SvPMP/SvPMP_sv48_*                       # Sv48 分页：RV32 无此模式
tests/priv/SvPMP/SvPMP_sv57_*                       # Sv57 分页：RV32 无此模式
tests/priv/SvPMPZicbo/SvPMPZicbo_sv39_*             # Sv39 + Zicbo：RV32 无此模式
tests/priv/SvPMPZicbo/SvPMPZicbo_sv48_*             # Sv48 + Zicbo：RV32 无此模式
tests/priv/SvPMPZicbo/SvPMPZicbo_sv57_*             # Sv57 + Zicbo：RV32 无此模式
tests/priv/SvZicbo/SvZicbo_sv39_*                   # Sv39 + Zicbo：RV32 无此模式
tests/priv/SvZicbo/SvZicbo_sv48_*                   # Sv48 + Zicbo：RV32 无此模式
tests/priv/SvZicbo/SvZicbo_sv57_*                   # Sv57 + Zicbo：RV32 无此模式
tests/priv/Sv/Sv_sv39_*                             # Sv39 通用分页用例：RV32 无此模式
tests/priv/Sv/Sv_sv48_*                             # Sv48 通用分页用例：RV32 无此模式
tests/priv/Sv/Sv_sv57_*                             # Sv57 通用分页用例：RV32 无此模式
tests/priv/ExceptionsSv/sv39_*                      # Sv39 异常用例：RV32 无此模式（该目录未扁平化）
tests/priv/ExceptionsSvZaamo/sv39_*                 # Sv39 + Zaamo：RV32 无此模式（同上）
tests/priv/ExceptionsSvZalrsc/sv39_*                # Sv39 + Zalrsc：RV32 无此模式（同上）
tests/priv/Svade/Svade_sv39_*                       # Sv39 + Svade：RV32 无此模式
tests/priv/Svade/Svade_sv48_*                       # Sv48 + Svade：RV32 无此模式
tests/priv/Svade/Svade_sv57_*                       # Sv57 + Svade：RV32 无此模式
# 说明：ExceptionsSv*/ 目录实际只含 sv32_*/sv39_* 两族（实测 ls），无 sv48_/sv57_ 文件，
#       故不登记不存在的前缀 —— 这正是 `--check-exclude` 逐条校验要挡住的那类"空规则"。
#       同理 Svade/ 只含 sv32_*/sv39_*/sv48_*/sv57_* 四族（实测），故四族分别登记。
