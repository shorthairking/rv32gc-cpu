# 仿真/单元测试产物
sim/log/
sim/tests/out/
*.vvp
*.vcd
*.fst

# arch-test 生成产物（参考签名/结果/ELF 均由脚本重建）
sim/arch_test/out/

# 审计定向验证产物：run_all.sh 逐例捕获 all_*.out，negative 夹具输出 log_*.out
# （log_*.log / ref_*.log 已由上方 *.log 忽略；vvp 已由 *.vvp 忽略）
# 可复现源码与证据仍追踪：run_*.sh、run_one.sh、ref_calc.py、*.sv、
# negative/ 反证夹具、README/results 与审计报告均不在忽略范围。
sim/audit/**/validation/**/*.out

# Vivado 工程/综合/实现产物（可由 fpga/tcl/*.tcl 重新生成）
fpga/out/

# 项目源码与测试目录正常追踪；上一代实现仅作历史追溯，不能把 master 等同旧代冻结。
# 分支/快照身份以 AGENT.md、NEXT_SESSION.md 与 git 实际记录为准。
# 本文件只忽略可由脚本/工具重建的生成物，不隐藏源码或测试夹具。

# 散落产物（子 Agent 工作区/编译测试）
a.out
.work_fpu/
__pycache__/
*.pyc
fpga/ip/
fpga/scratch/
clockInfo.txt
tight_setup_hold_pins.txt
sw/**/out/
sw/**/xsim.dir/
# 板级诊断生成的混合旧 RTL overlay；不能依赖未入库的局部 .gitignore。
sw/m5_board/tb/scratch/

# 参考回答（外部 agent 输出，仅本地参考，不追踪）
answer.md
