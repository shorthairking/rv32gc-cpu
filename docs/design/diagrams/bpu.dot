// 锦标赛分支预测器结构（局部 + 全局 + 选择器）
digraph bpu {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, splines=polyline, nodesep=0.35, ranksep=0.5];
  node  [shape=box, style="filled,rounded", fontname="Helvetica", fontsize=9, fillcolor="#ffe9cc", color="#c98f3c"];
  edge  [fontname="Helvetica", fontsize=8, color="#40506b"];

  PC [label="取指 PC\n(IF0)", fillcolor="#dbe7ff", color="#4a6fa5"];
  HASH [label="哈希/索引生成\n(PC ^ GHR 折叠)", fillcolor="#f7f7f7", color="#777777"];

  subgraph cluster_glob {
    label="全局预测器 (Gshare)"; color="#c98f3c"; style="rounded,dashed";
    GHR [label="GHR 12 bit\n(分支结果历史)", fillcolor="#ffe9cc"];
    GPHT [label="全局 PHT\n4096 × 2bit 饱和计数器", fillcolor="#ffe9cc"];
  }
  subgraph cluster_loc {
    label="局部预测器"; color="#c98f3c"; style="rounded,dashed";
    LHT [label="局部历史表\n1024 × 8bit", fillcolor="#ffe9cc"];
    LPHT [label="局部 PHT\n4096 × 2bit", fillcolor="#ffe9cc"];
  }
  subgraph cluster_choice {
    label="选择器 (Tournament)"; color="#c98f3c"; style="rounded,dashed";
    CH [label="Choice PHT\n4096 × 2bit\n(哪个预测器更准)", fillcolor="#ffe9cc"];
  }

  BTB [label="BTB 512 项 4 路\n{tag, target, 类型(cond/call/ret/jal), 2bit 置信度}\n每 16B 取指块最多 2 个分支", fillcolor="#ffd9a0", color="#c98f3c"];
  RAS [label="RAS 32 项\n(推测深度恢复)", fillcolor="#ffd9a0", color="#c98f3c"];
  MUX [label="预测结果选择\n(方向 + 目标 + 类型)", fillcolor="#f7f7f7", color="#777777"];

  PRE [label="预测输出\npred_taken / pred_target\n到 IF0 PC 选择", fillcolor="#dbe7ff", color="#4a6fa5"];

  UPD [label="更新逻辑", fillcolor="#d8f0e8", color="#3f8f78"];
  UPD_EX [label="EX：分支解析\n(方向/目标/RAS/间接跳转)", fillcolor="#e2f5d8", color="#5d8f45"];
  UPD_RT [label="RT：提交时修正\n(仅提交路径可更新计数器)", fillcolor="#d8f0e8", color="#3f8f78"];

  PC -> HASH;
  HASH -> GPHT [label="PC[11:0] ^ GHR"];
  HASH -> LHT [label="PC[9:0]"];
  HASH -> CH  [label="PC[11:0] ^ GHR 折叠"];
  LHT -> LPHT [label="8bit 局部历史"];
  PC -> BTB;
  PC -> RAS [label="ret 预测"];

  GHR -> MUX [label="全局预测"];
  LPHT -> MUX [label="局部预测"];
  CH -> MUX [label="选择信号"];
  BTB -> MUX [label="目标/类型"];
  RAS -> MUX [label="返回目标"];
  MUX -> PRE;

  UPD_EX -> UPD [label="解析结果"];
  UPD_RT -> UPD [label="提交确认"];
  UPD -> GPHT [style=dashed, label="更新计数器"];
  UPD -> LPHT [style=dashed];
  UPD -> CH   [style=dashed];
  UPD -> BTB  [style=dashed, label="分配/替换"];
  UPD -> RAS  [style=dashed, label="push/pop"];
  UPD -> GHR  [style=dashed, label="实际方向移位"];
}
