 // CORE_PARAMS_VH
module mac_top;
  parameter integer W = 2;
  localparam integer S = (RV32GC_L1I_SIZE_KB * 1024);
  initial begin
    $display("W=%0d S=%0d", W, S);
    if (W != 2) $display("BAD");
    $finish;
  end
endmodule
