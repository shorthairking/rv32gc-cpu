    for (i = 0; i < 257; i = i + 1) begin
      instr_raw = vec[i][F_RAW+:32];
      #1;                                   // 组合逻辑稳定
      exp_ctrl  = vec[i][F_EXP_CTRL+:73];
      exp_mask  = vec[i][F_EXP_MASK+:73];
      diff      = (ctrl ^ exp_ctrl) & exp_mask;
      bit_idx   = -1;
      for (b = 0; b < 73; b = b + 1)
        if (diff[b] && (bit_idx < 0)) bit_idx = b;

      if (vec[i][F_EXP_LEGAL] !== legal) begin
        n_fail = n_fail + 1;
        report_fail("legal", "exp/got mismatch");
        i = 257;                // 只报第一个失败
      end else if (vec[i][F_EXP_ILEN+:2] !== ilen) begin
        n_fail = n_fail + 1;
        report_fail("ilen", "exp/got mismatch");
        i = 257;
      end else if (vec[i][F_EXP_INSTR+:32] !== instr) begin
        n_fail = n_fail + 1;
        report_fail("instr", "exp/got mismatch");
        i = 257;
      end else if (bit_idx >= 0) begin
        n_fail = n_fail + 1;
        report_fail("ctrl", "exp/got mismatch");
        i = 257;
      end else if (vec[i][F_EXP_RS1+:5] !== rs1_arch) begin
        n_fail = n_fail + 1;
        report_fail("rs1_arch", "exp/got mismatch");
        i = 257;
      end else if (vec[i][F_EXP_RS2+:5] !== rs2_arch) begin
        n_fail = n_fail + 1;
        report_fail("rs2_arch", "exp/got mismatch");
        i = 257;
      end else if (vec[i][F_EXP_RS3+:5] !== rs3_arch) begin
        n_fail = n_fail + 1;
        report_fail("rs3_arch", "exp/got mismatch");
        i = 257;
      end else if (vec[i][F_EXP_RD+:5] !== rd_arch) begin
        n_fail = n_fail + 1;
        report_fail("rd_arch", "exp/got mismatch");
        i = 257;
      end else if (vec[i][F_EXP_IMM+:32] !== imm) begin
        n_fail = n_fail + 1;
        report_fail("imm", "exp/got mismatch");
        i = 257;
      end else begin
        if (vec[i][F_EXP_LEGAL])
          n_legal = n_legal + 1;
        else
          n_illegal = n_illegal + 1;
      end
    end

    if (n_fail == 0)
      $display("DECODER_UNIT_TESTS: PASS (%0d vectors)", 257);
    else
      $display("DECODER_UNIT_TESTS: FAIL (%0d vectors, %0d legal, %0d illegal checked before failure)",
               257, n_legal, n_illegal);
    $display("[覆盖] 已检查合法 %0d 条 / 非法 %0d 条 / 合计 %0d 条",
             n_legal, n_illegal, n_legal + n_illegal);
    $finish;
  end

endmodule
